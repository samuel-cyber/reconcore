# --- LLM provider -----------------------------------------------------------------
# Primary: Meta Model API (Muse Spark), OpenAI-compatible chat completions.
LLM_MODEL=openai/muse-spark-1.1
LLM_API_BASE=https://api.meta.ai/v1
LLM_API_KEY=            # Meta MODEL_API_KEY
LLM_REASONING_EFFORT=minimal

# Optional fallback, tried only if the primary fails. Leave blank to go straight to
# the hand-written templates.
LLM_FALLBACK_MODEL=     # e.g. openai/<featherless model id>
LLM_FALLBACK_API_BASE=https://api.featherless.ai/v1
LLM_FALLBACK_API_KEY=

# Hard timeout in seconds, per model, before falling back.
LLM_TIMEOUT_S=5

# --- identity ---------------------------------------------------------------------
# Ed25519 issuer private key, raw 32 bytes, base64. Generate with
# `python3 scripts/generate_issuer_key.py`. If unset, a key is generated into
# keys/issuer.key and a warning is logged telling you to copy it into the host env.
ISSUER_PRIVATE_KEY_B64=

# --- app --------------------------------------------------------------------------
DB_PATH=./reconcore.db
CORS_ORIGINS=http://localhost:3000,https://reconcore.vercel.app
PUBLIC_BASE_URL=http://localhost:8000
