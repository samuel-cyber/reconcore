# LiteLLM model string (any provider LiteLLM supports). Everything still works with no key set.
LLM_MODEL=gemini/gemini-2.5-flash
# One of these, depending on LLM_MODEL. Leave blank to run fully offline (template brief + template hints).
GEMINI_API_KEY=
OPENAI_API_KEY=
# Hard timeout in seconds before falling back to templates.
LLM_TIMEOUT_S=5
# Ed25519 issuer private key, raw 32 bytes, base64. If unset, a key is generated into keys/issuer.key
# and a warning is logged telling you to copy it into the host env (so badges survive restarts).
ISSUER_PRIVATE_KEY_B64=
# SQLite file.
DB_PATH=./reconcore.db
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,https://reconcore.vercel.app
# Used in badge `id` and issuer URLs.
PUBLIC_BASE_URL=http://localhost:8000
